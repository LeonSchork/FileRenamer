<UserControl x:Class="FileRenamer.UserTextInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FileRenamer"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="300">
    <Grid>
        <TextBox x:Name="InputTextBox" VerticalAlignment="Center" Padding="6" Height="30"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="InputTextBox_TextChanged" GotFocus="InputTextBox_GotFocus" LostFocus="InputTextBox_LostFocus"
                 Background="{Binding PlaceholderBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <TextBlock x:Name="OverlayLabel" Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   VerticalAlignment="Center" Padding="6" Height="30" Foreground="{Binding PlaceholderForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="{Binding PlaceholderFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   FontStyle="{Binding PlaceholderFontStyle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   IsHitTestVisible="False"/>

    </Grid>
</UserControl>
